# Multi-stage build approach to isolate extension compilation
FROM php:8.2-cli as php-extensions

# Resource Management Configuration
ENV DEBIAN_FRONTEND=noninteractive
ENV MAKEFLAGS="-j2"
ENV COMPOSER_MEMORY_LIMIT=512M
ENV NODE_OPTIONS="--max-old-space-size=512"

# Build monitoring: Start timestamp and progress tracking
RUN echo "=== BUILD MONITORING: PHP Extensions Stage Started ===" && \
    echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "Stage: php-extensions" && \
    echo "Expected duration: 5-8 minutes" && \
    echo "Critical hang points: PDO and PDO MySQL compilation" && \
    echo "=== RESOURCE MANAGEMENT: Configuration Applied ===" && \
    echo "Parallel compilation jobs: 2 (MAKEFLAGS=-j2)" && \
    echo "Composer memory limit: 512M" && \
    echo "Node.js memory limit: 512MB" && \
    echo "Non-interactive mode: enabled" && \
    echo "✓ Resource limits configured for build stability"

# Install system dependencies with comprehensive monitoring and resource management
RUN set -e; \
    echo "=== STEP 1/10: Updating package lists ===" && \
    echo "Progress: [##--------] 20% - Updating apt repositories" && \
    echo "Timeout warning: This step should complete within 60 seconds" && \
    echo "=== RESOURCE MANAGEMENT: Configuring apt for efficiency ===" && \
    echo 'APT::Get::Assume-Yes "true";' > /etc/apt/apt.conf.d/90assumeyes && \
    echo 'APT::Install-Recommends "false";' > /etc/apt/apt.conf.d/90norecommends && \
    echo 'APT::Install-Suggests "false";' > /etc/apt/apt.conf.d/90nosuggests && \
    echo 'Dpkg::Use-Pty "0";' > /etc/apt/apt.conf.d/90nopty && \
    echo "✓ APT configured for minimal resource usage" && \
    timeout 60 apt-get update && \
    echo "✓ Package lists updated successfully" && \
    \
    echo "=== STEP 2/10: Installing system dependencies ===" && \
    echo "Progress: [####------] 40% - Installing development libraries" && \
    echo "Installing: libpng-dev libonig-dev libxml2-dev libzip-dev" && \
    echo "Timeout warning: This step should complete within 120 seconds" && \
    echo "=== RESOURCE MANAGEMENT: Installing minimal required packages ===" && \
    timeout 120 apt-get install -y --no-install-recommends --no-install-suggests \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    build-essential \
    pkg-config && \
    echo "✓ System dependencies installed successfully" && \
    echo "=== RESOURCE CLEANUP: Removing package cache ===" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    echo "✓ Package cache and temporary files cleaned" && \
    \
    echo "=== CHECKPOINT: System dependencies verification ===" && \
    dpkg -l | grep -E "(libpng-dev|libonig-dev|libxml2-dev|libzip-dev)" && \
    echo "✓ All required development libraries are present"

# PHP Extensions installation with detailed monitoring, progress tracking, and resource management
RUN set -e; \
    echo "=== RESOURCE MANAGEMENT: Configuring PHP compilation environment ===" && \
    echo "Setting compilation flags for resource efficiency..." && \
    export CFLAGS="-O2 -pipe" && \
    export CXXFLAGS="-O2 -pipe" && \
    export LDFLAGS="-Wl,--as-needed" && \
    echo "Compilation flags: CFLAGS=$CFLAGS CXXFLAGS=$CXXFLAGS" && \
    echo "Linker flags: LDFLAGS=$LDFLAGS" && \
    echo "Parallel jobs: $MAKEFLAGS" && \
    echo "✓ Compilation environment optimized for resource efficiency" && \
    \
    echo "=== STEP 3/10: Installing PDO extension (CRITICAL HANG POINT) ===" && \
    echo "Progress: [######----] 60% - Compiling PDO extension" && \
    echo "⚠️  HANG ALERT: This is a known hang point - timeout set to 180 seconds" && \
    echo "Starting PDO compilation at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== RESOURCE MONITORING: Pre-compilation status ===" && \
    echo "Available memory: $(free -h | grep '^Mem:' | awk '{print $7}')" && \
    echo "Available disk space: $(df -h /tmp | tail -1 | awk '{print $4}')" && \
    (timeout 180 docker-php-ext-install pdo && \
     echo "✓ PDO extension compiled successfully" || \
        (echo "❌ PDO install failed, trying alternative approach..." && \
         echo "Attempting configure + install approach..." && \
         timeout 120 docker-php-ext-configure pdo && \
         echo "✓ PDO configured successfully" && \
         timeout 120 docker-php-ext-install pdo && \
         echo "✓ PDO extension installed via alternative method")) && \
    echo "PDO compilation completed at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== RESOURCE CLEANUP: Post-PDO cleanup ===" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    echo "✓ Temporary compilation files cleaned" && \
    \
    echo "=== STEP 4/10: Installing PDO MySQL extension (CRITICAL HANG POINT) ===" && \
    echo "Progress: [#######---] 70% - Compiling PDO MySQL extension" && \
    echo "⚠️  HANG ALERT: This is a known hang point - timeout set to 180 seconds" && \
    echo "Starting PDO MySQL compilation at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== RESOURCE MONITORING: Pre-compilation status ===" && \
    echo "Available memory: $(free -h | grep '^Mem:' | awk '{print $7}')" && \
    echo "Available disk space: $(df -h /tmp | tail -1 | awk '{print $4}')" && \
    (timeout 180 docker-php-ext-install pdo_mysql && \
     echo "✓ PDO MySQL extension compiled successfully" || \
        (echo "❌ PDO MySQL install failed, trying alternative approach..." && \
         echo "Attempting configure + install approach..." && \
         timeout 120 docker-php-ext-configure pdo_mysql && \
         echo "✓ PDO MySQL configured successfully" && \
         timeout 120 docker-php-ext-install pdo_mysql && \
         echo "✓ PDO MySQL extension installed via alternative method")) && \
    echo "PDO MySQL compilation completed at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== RESOURCE CLEANUP: Post-PDO MySQL cleanup ===" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    echo "✓ Temporary compilation files cleaned"

# Continue with remaining extensions with monitoring and resource management
RUN set -e; \
    echo "=== STEP 5/10: Installing mbstring extension ===" && \
    echo "Progress: [########--] 80% - Compiling mbstring" && \
    echo "Timeout warning: Should complete within 120 seconds" && \
    timeout 120 docker-php-ext-install mbstring && \
    echo "✓ mbstring extension installed successfully" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    \
    echo "=== STEP 6/10: Installing exif extension ===" && \
    echo "Progress: [########--] 82% - Compiling exif" && \
    timeout 120 docker-php-ext-install exif && \
    echo "✓ exif extension installed successfully" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    \
    echo "=== STEP 7/10: Installing pcntl extension ===" && \
    echo "Progress: [########--] 84% - Compiling pcntl" && \
    timeout 120 docker-php-ext-install pcntl && \
    echo "✓ pcntl extension installed successfully" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    \
    echo "=== STEP 8/10: Installing bcmath extension ===" && \
    echo "Progress: [########--] 86% - Compiling bcmath" && \
    timeout 120 docker-php-ext-install bcmath && \
    echo "✓ bcmath extension installed successfully" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    \
    echo "=== STEP 9/10: Installing gd extension ===" && \
    echo "Progress: [#########-] 90% - Compiling gd" && \
    timeout 120 docker-php-ext-install gd && \
    echo "✓ gd extension installed successfully" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    \
    echo "=== STEP 10/10: Installing zip extension ===" && \
    echo "Progress: [#########-] 95% - Compiling zip" && \
    timeout 120 docker-php-ext-install zip && \
    echo "✓ zip extension installed successfully" && \
    rm -rf /tmp/pear /tmp/php* /var/tmp/* && \
    echo "=== RESOURCE CLEANUP: Final extension cleanup ===" && \
    echo "✓ All temporary compilation files cleaned after each extension"

# Final verification and cleanup with monitoring
RUN echo "=== FINAL CHECKPOINT: PHP Extensions Stage Verification ===" && \
    echo "Progress: [##########] 100% - Verifying all extensions" && \
    php -m | grep -E "(pdo|pdo_mysql|mbstring|exif|pcntl|bcmath|gd|zip)" && \
    echo "✓ All PHP extensions verified successfully" && \
    echo "=== CLEANUP: Removing package cache ===" && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    echo "✓ Package cache cleaned" && \
    echo "=== BUILD MONITORING: PHP Extensions Stage Completed ===" && \
    echo "Completion timestamp: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "✅ PHP extensions stage completed successfully"

# Main application stage with resource management
FROM php:8.2-cli

# Resource Management Configuration for main stage
ENV DEBIAN_FRONTEND=noninteractive
ENV COMPOSER_MEMORY_LIMIT=512M
ENV NODE_OPTIONS="--max-old-space-size=512"
ENV NPM_CONFIG_CACHE=/tmp/.npm
ENV COMPOSER_CACHE_DIR=/tmp/.composer

# Build monitoring: Application stage start
RUN echo "=== BUILD MONITORING: Application Stage Started ===" && \
    echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "Stage: main application" && \
    echo "Expected duration: 8-12 minutes" && \
    echo "Critical operations: Composer install, npm install, asset build" && \
    echo "=== RESOURCE MANAGEMENT: Main stage configuration ===" && \
    echo "Composer memory limit: $COMPOSER_MEMORY_LIMIT" && \
    echo "Node.js memory limit: 512MB" && \
    echo "NPM cache directory: $NPM_CONFIG_CACHE" && \
    echo "Composer cache directory: $COMPOSER_CACHE_DIR" && \
    echo "✓ Resource limits configured for application stage"

# Copy pre-compiled extensions with verification
RUN echo "=== STEP 1/15: Copying pre-compiled PHP extensions ===" && \
    echo "Progress: [#---------] 7% - Copying extension files"
COPY --from=php-extensions /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-extensions /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
RUN echo "✓ PHP extensions copied successfully" && \
    echo "=== CHECKPOINT: Extension files verification ===" && \
    ls -la /usr/local/lib/php/extensions/ && \
    ls -la /usr/local/etc/php/conf.d/ && \
    echo "✓ Extension files present and accessible"

# Install runtime dependencies with detailed monitoring and resource optimization
RUN set -e; \
    echo "=== STEP 2/15: Installing runtime dependencies ===" && \
    echo "Progress: [##--------] 14% - Installing system packages" && \
    echo "Timeout warning: This step should complete within 180 seconds" && \
    echo "Installing: git curl zip unzip nodejs npm libpng16-16 libzip4" && \
    echo "=== RESOURCE MANAGEMENT: Configuring apt for efficiency ===" && \
    echo 'APT::Get::Assume-Yes "true";' > /etc/apt/apt.conf.d/90assumeyes && \
    echo 'APT::Install-Recommends "false";' > /etc/apt/apt.conf.d/90norecommends && \
    echo 'APT::Install-Suggests "false";' > /etc/apt/apt.conf.d/90nosuggests && \
    echo 'Dpkg::Use-Pty "0";' > /etc/apt/apt.conf.d/90nopty && \
    echo 'APT::Keep-Downloaded-Packages "false";' > /etc/apt/apt.conf.d/90nokeep && \
    echo "✓ APT configured for minimal resource usage" && \
    timeout 180 apt-get update && \
    echo "✓ Package lists updated" && \
    timeout 240 apt-get install -y --no-install-recommends --no-install-suggests \
    git \
    curl \
    zip \
    unzip \
    nodejs \
    npm \
    libpng16-16 \
    libzip4 && \
    echo "✓ Runtime dependencies installed successfully" && \
    echo "=== CHECKPOINT: Runtime dependencies verification ===" && \
    which git curl zip unzip node npm && \
    node --version && npm --version && \
    echo "✓ All runtime tools are available and functional" && \
    echo "=== RESOURCE CLEANUP: Removing package cache and temporary files ===" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/apt/* && \
    echo "✓ Package cache and temporary files cleaned"

# Install Composer with monitoring
RUN echo "=== STEP 3/15: Installing Composer ===" && \
    echo "Progress: [###-------] 21% - Installing Composer"
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN echo "✓ Composer installed successfully" && \
    composer --version && \
    echo "✓ Composer is functional"

# Set working directory with monitoring
RUN echo "=== STEP 4/15: Setting up workspace ===" && \
    echo "Progress: [####------] 28% - Configuring workspace"
WORKDIR /var/www
RUN echo "✓ Working directory set to /var/www" && \
    pwd && ls -la

# Copy composer files with monitoring
RUN echo "=== STEP 5/15: Copying Composer configuration ===" && \
    echo "Progress: [#####-----] 35% - Copying dependency files"
COPY composer.json composer.lock ./
RUN echo "✓ Composer files copied" && \
    echo "=== CHECKPOINT: Composer files verification ===" && \
    ls -la composer.* && \
    echo "✓ Composer configuration files are present"

# Install PHP dependencies with comprehensive monitoring and resource management
RUN set -e; \
    echo "=== STEP 6/15: Installing PHP dependencies (POTENTIAL HANG POINT) ===" && \
    echo "Progress: [######----] 42% - Running Composer install" && \
    echo "⚠️  HANG ALERT: Composer install can hang on slow networks - timeout set to 300 seconds" && \
    echo "Starting Composer install at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== RESOURCE MANAGEMENT: Composer configuration ===" && \
    echo "Memory limit: $COMPOSER_MEMORY_LIMIT" && \
    echo "Cache directory: $COMPOSER_CACHE_DIR" && \
    echo "Current PHP memory limit: $(php -r 'echo ini_get("memory_limit");')" && \
    mkdir -p $COMPOSER_CACHE_DIR && \
    echo "✓ Composer cache directory created" && \
    echo "=== RESOURCE MONITORING: Pre-install status ===" && \
    echo "Available memory: $(free -h | grep '^Mem:' | awk '{print $7}')" && \
    echo "Available disk space: $(df -h . | tail -1 | awk '{print $4}')" && \
    (timeout 300 composer install --no-dev --optimize-autoloader --no-interaction --no-scripts --prefer-dist && \
     echo "✓ Composer install completed successfully" || \
     (echo "❌ Composer install failed, retrying with increased memory..." && \
      echo "Increasing memory limit to 1G and retrying..." && \
      timeout 300 php -d memory_limit=1G /usr/local/bin/composer install --no-dev --optimize-autoloader --no-interaction --no-scripts --prefer-dist && \
      echo "✓ Composer install completed with increased memory")) && \
    echo "Composer install completed at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== CHECKPOINT: PHP dependencies verification ===" && \
    ls -la vendor/ && \
    composer show --installed | head -10 && \
    echo "✓ PHP dependencies installed and verified" && \
    echo "=== RESOURCE CLEANUP: Composer cache cleanup ===" && \
    rm -rf $COMPOSER_CACHE_DIR /tmp/composer* && \
    echo "✓ Composer cache cleaned"

# Copy Node.js configuration with monitoring
RUN echo "=== STEP 7/15: Copying Node.js configuration ===" && \
    echo "Progress: [#######---] 49% - Copying package files"
COPY package.json ./
RUN echo "✓ package.json copied"

# Copy package-lock.json with conditional monitoring
RUN echo "=== STEP 8/15: Copying package-lock.json (if exists) ===" && \
    echo "Progress: [########--] 56% - Checking for lock file"
COPY package-lock.json* ./
RUN echo "✓ package-lock.json copied (if present)" && \
    echo "=== CHECKPOINT: Node.js configuration verification ===" && \
    ls -la package* && \
    if [ -f package-lock.json ]; then \
        echo "✓ package-lock.json found - will use npm ci for reproducible builds"; \
    else \
        echo "⚠️  No package-lock.json found - will use npm install and generate lock file"; \
    fi

# Install Node dependencies with comprehensive monitoring and resource management
RUN set -e; \
    echo "=== STEP 9/15: Installing Node.js dependencies (POTENTIAL HANG POINT) ===" && \
    echo "Progress: [#########-] 63% - Running npm install/ci" && \
    echo "⚠️  HANG ALERT: npm operations can hang on network issues - timeout set to 300 seconds" && \
    echo "Starting npm operation at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== RESOURCE MANAGEMENT: NPM configuration ===" && \
    echo "Node.js memory limit: $NODE_OPTIONS" && \
    echo "NPM cache directory: $NPM_CONFIG_CACHE" && \
    mkdir -p $NPM_CONFIG_CACHE && \
    echo "✓ NPM cache directory created" && \
    echo "=== RESOURCE MONITORING: Pre-install status ===" && \
    echo "Available memory: $(free -h | grep '^Mem:' | awk '{print $7}')" && \
    echo "Available disk space: $(df -h . | tail -1 | awk '{print $4}')" && \
    if [ -f package-lock.json ] && [ -s package-lock.json ]; then \
        echo "Found package-lock.json, using npm ci for reproducible builds" && \
        echo "npm ci provides faster, reliable, reproducible builds" && \
        (timeout 300 npm ci --no-audit --no-fund --prefer-offline --cache $NPM_CONFIG_CACHE && \
         echo "✓ npm ci completed successfully" || \
         (echo "❌ npm ci failed, falling back to npm install..." && \
          echo "Attempting npm install as fallback..." && \
          timeout 300 npm install --no-audit --no-fund --prefer-offline --cache $NPM_CONFIG_CACHE && \
          echo "✓ npm install completed as fallback")); \
    else \
        echo "No package-lock.json found, using npm install and generating lock file" && \
        echo "This will generate package-lock.json for future builds" && \
        timeout 300 npm install --no-audit --no-fund --prefer-offline --cache $NPM_CONFIG_CACHE && \
        echo "✓ npm install completed successfully" && \
        echo "✓ Generated package-lock.json for future builds"; \
    fi && \
    echo "npm operation completed at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== CHECKPOINT: Node.js dependencies verification ===" && \
    ls -la node_modules/ | head -5 && \
    npm list --depth=0 | head -10 && \
    echo "✓ Node.js dependencies installed and verified" && \
    echo "=== RESOURCE CLEANUP: NPM cache cleanup ===" && \
    rm -rf $NPM_CONFIG_CACHE /tmp/npm* && \
    echo "✓ NPM cache cleaned"

# Build assets with comprehensive monitoring and resource management
RUN set -e; \
    echo "=== STEP 10/15: Building frontend assets (POTENTIAL HANG POINT) ===" && \
    echo "Progress: [##########] 70% - Running npm run build" && \
    echo "⚠️  HANG ALERT: Asset compilation can hang on complex builds - timeout set to 300 seconds" && \
    echo "Starting asset build at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "=== RESOURCE MANAGEMENT: Build configuration ===" && \
    echo "Node.js memory limit: $NODE_OPTIONS" && \
    echo "=== RESOURCE MONITORING: Pre-build status ===" && \
    echo "Available memory: $(free -h | grep '^Mem:' | awk '{print $7}')" && \
    echo "Available disk space: $(df -h . | tail -1 | awk '{print $4}')" && \
    echo "Available npm scripts:" && \
    npm run 2>&1 | grep -E "^  " || echo "No scripts found" && \
    timeout 300 npm run build && \
    echo "Asset build completed at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "✓ Frontend build completed successfully" && \
    echo "=== CHECKPOINT: Build output verification ===" && \
    ls -la public/ | head -10 && \
    echo "✓ Build artifacts generated successfully" && \
    echo "=== RESOURCE CLEANUP: Build artifacts cleanup ===" && \
    rm -rf /tmp/npm* /tmp/node* && \
    echo "✓ Temporary build files cleaned"

# Clean npm cache with monitoring and resource cleanup
RUN echo "=== STEP 11/15: Cleaning npm cache and optimizing image size ===" && \
    echo "Progress: [##########] 77% - Optimizing image size" && \
    echo "=== RESOURCE CLEANUP: Comprehensive cleanup ===" && \
    npm cache clean --force && \
    echo "✓ npm cache cleaned successfully" && \
    rm -rf /tmp/* /var/tmp/* /root/.npm /root/.cache && \
    echo "✓ All temporary files and caches cleaned" && \
    echo "=== RESOURCE MONITORING: Post-cleanup status ===" && \
    echo "Available disk space: $(df -h . | tail -1 | awk '{print $4}')" && \
    echo "✓ Disk space optimized"

# Copy application files with monitoring
RUN echo "=== STEP 12/15: Copying application files ===" && \
    echo "Progress: [##########] 84% - Copying source code"
COPY . .
RUN echo "✓ Application files copied" && \
    echo "=== CHECKPOINT: Application files verification ===" && \
    ls -la && \
    echo "✓ All application files are present"

# Run composer scripts with monitoring
RUN echo "=== STEP 13/15: Running Composer post-install scripts ===" && \
    echo "Progress: [##########] 91% - Executing post-install hooks" && \
    echo "Timeout warning: Should complete within 60 seconds" && \
    timeout 60 composer run-script post-autoload-dump 2>/dev/null || \
    (echo "⚠️  Composer post-install scripts failed or not found - continuing..." && true) && \
    echo "✓ Composer scripts completed"

# Set permissions with comprehensive monitoring
RUN set -e; \
    echo "=== STEP 14/15: Setting file permissions ===" && \
    echo "Progress: [##########] 98% - Configuring file permissions" && \
    echo "Setting permissions for storage and bootstrap/cache directories..." && \
    chmod -R 775 storage bootstrap/cache 2>/dev/null || \
    (echo "⚠️  chmod failed for some files - continuing..." && true) && \
    chown -R www-data:www-data storage bootstrap/cache 2>/dev/null || \
    (echo "⚠️  chown failed for some files - continuing..." && true) && \
    echo "✓ Permissions set successfully" && \
    echo "=== CHECKPOINT: Permissions verification ===" && \
    ls -la storage/ bootstrap/cache/ && \
    echo "✓ Directory permissions configured"

# Copy and configure startup script with monitoring
RUN echo "=== STEP 15/15: Configuring startup script ===" && \
    echo "Progress: [##########] 99% - Setting up startup script"
COPY railway-start.sh /railway-start.sh
RUN chmod +x /railway-start.sh && \
    echo "✓ Startup script configured" && \
    ls -la /railway-start.sh && \
    echo "✓ Startup script is executable"

# Final verification with comprehensive monitoring and resource management
RUN set -e; \
    echo "=== FINAL VERIFICATION: PHP Extensions and Build Completion ===" && \
    echo "Progress: [##########] 100% - Final verification" && \
    echo "Verifying all required PHP extensions are loaded..." && \
    php -m | grep -E "(pdo|pdo_mysql|mbstring|gd|zip)" && \
    echo "✓ All required PHP extensions are loaded successfully" && \
    echo "=== FINAL CHECKPOINT: Complete build verification ===" && \
    php --version && \
    composer --version && \
    node --version && \
    npm --version && \
    echo "✓ All tools are functional" && \
    echo "=== RESOURCE MANAGEMENT: Final optimization ===" && \
    echo "Performing final cleanup and optimization..." && \
    rm -rf /tmp/* /var/tmp/* /root/.cache /root/.npm /var/cache/* && \
    echo "✓ All temporary files cleaned" && \
    echo "=== RESOURCE MONITORING: Final status ===" && \
    echo "Final disk usage: $(df -h . | tail -1 | awk '{print $5}')" && \
    echo "Available memory: $(free -h | grep '^Mem:' | awk '{print $7}')" && \
    echo "✓ Resource optimization completed" && \
    echo "=== BUILD MONITORING: Application Stage Completed ===" && \
    echo "Completion timestamp: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "✅ Docker build completed successfully - ready for deployment"

# Resource Management Configuration for Runtime
RUN echo "=== RESOURCE MANAGEMENT: Runtime configuration ===" && \
    echo "Configuring PHP runtime resource limits..." && \
    echo "memory_limit = 256M" > /usr/local/etc/php/conf.d/99-resource-limits.ini && \
    echo "max_execution_time = 300" >> /usr/local/etc/php/conf.d/99-resource-limits.ini && \
    echo "max_input_time = 300" >> /usr/local/etc/php/conf.d/99-resource-limits.ini && \
    echo "post_max_size = 64M" >> /usr/local/etc/php/conf.d/99-resource-limits.ini && \
    echo "upload_max_filesize = 64M" >> /usr/local/etc/php/conf.d/99-resource-limits.ini && \
    echo "max_file_uploads = 20" >> /usr/local/etc/php/conf.d/99-resource-limits.ini && \
    echo "✓ PHP runtime resource limits configured" && \
    echo "=== RESOURCE MANAGEMENT: Process limits ===" && \
    echo "Setting process and file descriptor limits..." && \
    echo "* soft nofile 65536" >> /etc/security/limits.conf && \
    echo "* hard nofile 65536" >> /etc/security/limits.conf && \
    echo "* soft nproc 32768" >> /etc/security/limits.conf && \
    echo "* hard nproc 32768" >> /etc/security/limits.conf && \
    echo "✓ Process and file descriptor limits configured" && \
    echo "=== RESOURCE MANAGEMENT: Swap configuration ===" && \
    echo "Configuring swap behavior for memory management..." && \
    echo "vm.swappiness = 10" >> /etc/sysctl.conf && \
    echo "vm.vfs_cache_pressure = 50" >> /etc/sysctl.conf && \
    echo "vm.dirty_ratio = 15" >> /etc/sysctl.conf && \
    echo "vm.dirty_background_ratio = 5" >> /etc/sysctl.conf && \
    echo "✓ Swap and memory management configured" && \
    echo "=== RESOURCE MANAGEMENT: Configuration summary ===" && \
    echo "PHP memory limit: 256M" && \
    echo "Max execution time: 300s" && \
    echo "File descriptor limit: 65536" && \
    echo "Process limit: 32768" && \
    echo "Swap aggressiveness: Low (10)" && \
    echo "✅ All resource management configurations applied"

EXPOSE 8080

# Health check with enhanced monitoring and resource awareness
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD echo "=== HEALTH CHECK: Verifying container health ===" && \
        echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')" && \
        echo "=== RESOURCE MONITORING: Current status ===" && \
        echo "Memory usage: $(free -h | grep '^Mem:' | awk '{print $3"/"$2}')" && \
        echo "Disk usage: $(df -h . | tail -1 | awk '{print $5}')" && \
        echo "Load average: $(uptime | awk -F'load average:' '{print $2}')" && \
        php -v && \
        echo "✓ PHP is responsive" && \
        echo "✓ Container health check passed" || \
        (echo "❌ Health check failed - PHP not responding" && exit 1)

# Runtime monitoring setup
RUN echo "=== RUNTIME MONITORING SETUP ===" && \
    echo "Container build completed at: $(date '+%Y-%m-%d %H:%M:%S')" && \
    echo "Image size optimization completed" && \
    echo "Ready for Railway deployment" && \
    echo "Expected startup time: 30-60 seconds" && \
    echo "Health check interval: 30 seconds" && \
    echo "✅ Container ready for production deployment"

CMD ["/railway-start.sh"]